# Copy to .env and fill in. .env is git-ignored; .env.example is committed.

# Shared key required for every admin write. Leave unset for an open demo.
ADMIN_KEY=

# Optional: mirror routes / jeepneys / destinations into Supabase (Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional
PORT=8080
HOST=0.0.0.0
# DATA_DIR=
