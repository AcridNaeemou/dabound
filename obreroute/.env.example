# Copy to .env and fill in. .env is git-ignored; .env.example is committed.

# The shared PIN that unlocks the admin area and gates every admin write.
# Defaults to ObreRoute when unset, so a deployment is PIN-protected out of the
# box. Set your own to change it, or set ADMIN_KEY=none for an open one-tap demo.
ADMIN_KEY=ObreRoute

# Optional: mirror routes / jeepneys / destinations into Supabase (Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional
PORT=8080
HOST=0.0.0.0
# DATA_DIR=
